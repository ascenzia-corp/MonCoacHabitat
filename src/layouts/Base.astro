---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CallBar from '../components/CallBar.astro';
import { site } from '../data/site';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  title: string;
  description?: string;
  active?: 'prestations' | 'academie' | 'demande';
  footerRule?: boolean;
  callBarSecondary?: 'demande' | 'whatsapp';
  /** Optional social image. Defaults to the logo. */
  image?: ImageMetadata;
}
const { title, description = site.description, active, footerRule = false, callBarSecondary = 'demande', image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = image ? await getImage({ src: image, width: 1200, height: 630, format: 'webp' }) : null;
const ogImage = og ? new URL(og.src, Astro.site) : new URL('/assets/logo.png', Astro.site);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/casque.png" type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="theme-color" content="#3B3129" />
  </head>
  <body>
    <Nav active={active} />
    <slot />
    <Footer rule={footerRule} />
    <CallBar secondary={callBarSecondary} />
    <script>
      // Reveal on scroll: only elements below the fold at load are hidden,
      // then shown once (12 % visible). Disabled under prefers-reduced-motion.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      if (!reduce && 'IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
          }
        }, { threshold: 0.12 });
        for (const el of els) {
          if (el.getBoundingClientRect().top > window.innerHeight) el.classList.add('is-hidden');
          io.observe(el);
        }
      }
    </script>
  </body>
</html>
