---
/* A photo slot: renders the real <img> when `photo.src` exists, otherwise the
   striped placeholder with its framing brief. No placeholder may ship. */
import type { Photo } from '../data/content';

interface Props {
  photo: Photo;
  /** CSS aspect-ratio, e.g. "4 / 3" or "16 / 9". */
  ratio?: string;
  class?: string;
  /** Prefix on the placeholder label, e.g. "photo 4:3". */
  kind?: string;
  loading?: 'lazy' | 'eager';
}
const { photo, ratio = '4 / 3', class: className = '', kind = 'photo 4:3', loading = 'lazy' } = Astro.props;
---
{photo.src ? (
  <div class:list={['photo', className]} style={`aspect-ratio:${ratio}`}>
    <img src={photo.src} alt={photo.alt} loading={loading} />
    <slot />
  </div>
) : (
  <div class:list={['photo', 'photo--ph', className]} style={`aspect-ratio:${ratio}`} role="img" aria-label={photo.alt || undefined}>
    <span class="photo__label">{kind} · {photo.brief}</span>
    <slot />
  </div>
)}
