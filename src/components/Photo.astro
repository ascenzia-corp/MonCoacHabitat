---
/* Photo réelle, exportée en WebP responsive au build. */
import { Image } from 'astro:assets';
import type { Photo } from '../data/content';

interface Props {
  photo: Photo;
  /** CSS aspect-ratio. Chaîne vide : le parent impose la taille (bandeau). */
  ratio?: string;
  class?: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
}
const {
  photo,
  ratio = '4 / 3',
  class: className = '',
  sizes = '(min-width: 900px) 40vw, 92vw',
  loading = 'lazy',
} = Astro.props;
const maxW = photo.src.width;
const widths = [480, 768, 1200, 1600, 2000].filter((w) => w < maxW);
if (!widths.includes(maxW)) widths.push(maxW);
---
<div class:list={['photo', className]} style={ratio ? `aspect-ratio:${ratio}` : undefined}>
  <Image
    src={photo.src}
    alt={photo.alt}
    widths={widths}
    sizes={sizes}
    format="webp"
    quality={75}
    loading={loading}
  />
  <slot />
</div>
