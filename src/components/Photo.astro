---
/* A photo slot. Images are optimized to WebP with a responsive srcset. */
import { Image } from 'astro:assets';
import type { Photo } from '../data/content';

interface Props {
  photo: Photo;
  /** CSS aspect-ratio, e.g. "4 / 3" or "16 / 9". */
  ratio?: string;
  class?: string;
  /** Prefix on the placeholder label, e.g. "photo 4:3". */
  kind?: string;
  loading?: 'lazy' | 'eager';
  widths?: number[];
  sizes?: string;
}
const {
  photo,
  ratio = '4 / 3',
  class: className = '',
  kind = 'photo 4:3',
  loading = 'lazy',
  widths = [480, 768, 1152],
  sizes = '(min-width: 900px) 40vw, 100vw',
} = Astro.props;
---
{photo.src ? (
  <div class:list={['photo', className]} style={`aspect-ratio:${ratio}`}>
    <Image src={photo.src} alt={photo.alt} widths={widths} sizes={sizes} format="webp" loading={loading} />
    <slot />
  </div>
) : (
  <div class:list={['photo', 'photo--ph', className]} style={`aspect-ratio:${ratio}`} role="img" aria-label={photo.alt || undefined}>
    <span class="photo__label">{kind} · {photo.brief}</span>
    <slot />
  </div>
)}
